rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ============================================================
       FONCTIONS UTILITAIRES
       ============================================================ */

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    /* Une demande de ramassage approuvee par l admin est obligatoire pour
       creer un produit vendeur. La demande doit appartenir au vendeur. */
    function pickupApproved(requestId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/vendor_pickup_requests/$(requestId)) &&
        get(/databases/$(database)/documents/vendor_pickup_requests/$(requestId)).data.vendorId == request.auth.uid &&
        get(/databases/$(database)/documents/vendor_pickup_requests/$(requestId)).data.status == 'approved';
    }


    /* Version de contrat courante : source unique de verite (config/app).
       Aucune version semver ne doit etre codee en dur dans ce fichier. */
    function currentContractVersion() {
      return get(/databases/$(database)/documents/config/app).data.contractVersion;
    }

    function userProfileExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isApprovedVendor(uid) {
      return isSignedIn() &&
        request.auth.uid == uid &&
        userProfileExists(uid) &&
        get(/databases/$(database)/documents/users/$(uid)).data.role == 'vendor' &&
        get(/databases/$(database)/documents/users/$(uid)).data.get('vendorInfo', {}).get('status', '') == 'approved' &&
        get(/databases/$(database)/documents/users/$(uid)).data.get('vendorInfo', {}).get('contractStatus', '') == 'accepted' &&
        get(/databases/$(database)/documents/users/$(uid)).data.get('vendorInfo', {}).get('contractVersion', '') == currentContractVersion();
    }

    function isVendorOwner(uid) {
      return isSignedIn() &&
        request.auth.uid == uid &&
        userProfileExists(uid) &&
        get(/databases/$(database)/documents/users/$(uid)).data.role == 'vendor';
    }

    /* ============================================================
       PROFILS UTILISATEURS
       ============================================================ */

    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid);

      allow create: if isAdmin() || (
        isSelf(uid) &&
        request.resource.data.get('isAdmin', false) == false &&
        request.resource.data.get('permissions', []) == [] &&
        (
          request.resource.data.role == 'user' ||
          (
            request.resource.data.role == 'vendor' &&
            request.resource.data.signupMethod == 'vendor' &&
            request.resource.data.get('vendorInfo', {}).get('status', '') == 'pending' &&
            request.resource.data.get('vendorInfo', {}).get('contractStatus', '') == 'pending'
          )
        )
      );

      allow update: if isAdmin() || (
        isSelf(uid) && (
          (
            request.resource.data.role == resource.data.role &&
            request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
            request.resource.data.get('permissions', []) == resource.data.get('permissions', []) &&
            request.resource.data.get('vendorId', uid) == resource.data.get('vendorId', uid) &&
            request.resource.data.get('vendorInfo', null) == resource.data.get('vendorInfo', null) &&
            request.resource.data.get('vendorInfo', {}).get('status', null) == resource.data.get('vendorInfo', {}).get('status', null) &&
            request.resource.data.get('vendorInfo', {}).get('contractStatus', null) == resource.data.get('vendorInfo', {}).get('contractStatus', null) &&
            request.resource.data.get('vendorInfo', {}).get('commissionRate', null) == resource.data.get('vendorInfo', {}).get('commissionRate', null) &&
            request.resource.data.get('vendorInfo', {}).get('commissionRateMin', null) == resource.data.get('vendorInfo', {}).get('commissionRateMin', null) &&
            request.resource.data.get('vendorInfo', {}).get('commissionRateMax', null) == resource.data.get('vendorInfo', {}).get('commissionRateMax', null) &&
            request.resource.data.get('vendorInfo', {}).get('currentContractId', null) == resource.data.get('vendorInfo', {}).get('currentContractId', null) &&
            request.resource.data.get('vendorInfo', {}).get('contractVersion', null) == resource.data.get('vendorInfo', {}).get('contractVersion', null) &&
            request.resource.data.get('vendorInfo', {}).get('contractSignedAt', null) == resource.data.get('vendorInfo', {}).get('contractSignedAt', null)
          ) ||
          (
            resource.data.get('role', 'user') == 'user' &&
            request.resource.data.role == 'vendor' &&
            request.resource.data.signupMethod == 'vendor' &&
            request.resource.data.get('vendorInfo', {}).get('status', '') == 'pending' &&
            request.resource.data.get('vendorInfo', {}).get('contractStatus', '') == 'pending' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'email', 'phone', 'role', 'signupMethod',
              'emailVerified', 'vendorInfo', 'updatedAt', 'createdAt'
            ])
          )
        )
      );

      allow delete: if isAdmin();
    }

    /* ============================================================
       PANIERS CLIENTS
       Données privées : chaque utilisateur ne lit et ne modifie que son panier.
       ============================================================ */

    match /carts/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid) &&
        request.resource.data.get('userId', '') == uid &&
        request.resource.data.keys().hasOnly(['userId', 'items', 'selectedCity', 'updatedAt']) &&
        request.resource.data.items is list &&
        request.resource.data.items.size() <= 100 &&
        (
          request.resource.data.get('selectedCity', null) == null ||
          request.resource.data.selectedCity is map
        ) &&
        request.resource.data.updatedAt is timestamp;
      allow delete: if isSelf(uid);
    }

    /* ============================================================
       FICHES VENDEURS PUBLIQUES
       ============================================================ */

    match /vendorsPublic/{vendorId} {
      allow read: if true;
      allow write: if false;
    }

    /* ============================================================
       CONTRATS : écriture exclusivement via Cloud Functions
       ============================================================ */

    match /contracts/{contractId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.vendorId == request.auth.uid);
      allow create, update, delete: if false;
    }

    /* ============================================================
       PRODUITS
       Public : uniquement les produits approuvés.
       Vendeur : lecture de ses propres fiches.
       Admin : accès complet.
       LEGACY (correctif audit 2026-11-20) : les fiches créées avant
       l'introduction du champ `status` n'ont PAS de status. L'ancienne
       règle `resource.data.get('status','') == 'approved'` les rendait
       invisibles alors que le client les affichait (js/products.js) :
       toute la boutique paraissait vide. On accepte donc explicitement
       l'ABSENCE de status (legacy uniquement), et rien d'autre.
       Toute nouvelle fiche porte obligatoirement un status
       (voir allow create : status == 'pending_admin_approval').
       ============================================================ */

    function isPublicProduct() {
      return !('status' in resource.data) ||
        resource.data.get('status', '') == 'approved';
    }

    match /products/{productId} {
      allow read: if isAdmin() ||
        isPublicProduct() ||
        (
          isSignedIn() &&
          resource.data.get('vendorId', '') == request.auth.uid &&
          isVendorOwner(request.auth.uid)
        );

      /* Creation vendeur : le formulaire dashboard envoie price/basePrice,
         stock, category, vendorId et status pending_admin_approval.
         On interdit uniquement les champs reserves a l'admin (ventes, notes)
         et on borne les valeurs pour eviter tout etat incoherent. */
      allow create: if isAdmin() || (
        isApprovedVendor(request.auth.uid) &&
        request.resource.data.vendorId == request.auth.uid &&
        request.resource.data.status == 'pending_admin_approval' &&
        request.resource.data.keys().hasAll(['nameFr', 'category', 'price', 'vendorId', 'status', 'koulchiPrice']) &&
        request.resource.data.nameFr is string &&
        request.resource.data.nameFr.size() >= 2 &&
        request.resource.data.nameFr.size() <= 200 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.price is number &&
        request.resource.data.price > 0 &&
        (!('basePrice' in request.resource.data) ||
          (request.resource.data.basePrice is number && request.resource.data.basePrice >= 0)) &&
        (!('oldPrice' in request.resource.data) ||
          (request.resource.data.oldPrice is number && request.resource.data.oldPrice >= 0)) &&
        /* K5 : prix de groupe OBLIGATOIRE. Il doit etre un nombre
           strictement inferieur au prix de vente, sinon la fiche est refusee.
           Le prix de groupe n est jamais deduit du prix : il est saisi. */
        request.resource.data.koulchiPrice is number &&
        request.resource.data.koulchiPrice > 0 &&
        request.resource.data.koulchiPrice < request.resource.data.price &&
        (!('stock' in request.resource.data) ||
          (request.resource.data.stock is int && request.resource.data.stock >= 0)) &&
        (!('vendorName' in request.resource.data) ||
          (request.resource.data.vendorName is string &&
           request.resource.data.vendorName.size() <= 120)) &&
        request.resource.data.get('warehouse_received', false) == true &&
        request.resource.data.get('pickupRequestId', '') is string &&
        request.resource.data.pickupRequestId.size() >= 10 &&
        pickupApproved(request.resource.data.pickupRequestId) &&
        request.resource.data.sku is string &&
        request.resource.data.sku.size() >= 6 &&
        request.resource.data.pickupItemIndex is number &&
        !('salesCount' in request.resource.data) &&
        !('ratingAvg' in request.resource.data) &&
        !('ratingCount' in request.resource.data)
      );

      allow update: if isAdmin() || (
        isApprovedVendor(request.auth.uid) &&
        resource.data.vendorId == request.auth.uid &&
        request.resource.data.vendorId == resource.data.vendorId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'salesCount', 'ratingAvg', 'ratingCount'
        ]) &&
        (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'price', 'nameFr', 'nameEn', 'nameAr', 'koulchiPrice'
            ]) &&
            request.resource.data.status == 'pending_admin_approval'
          ) ||
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'price', 'nameFr', 'nameEn', 'nameAr', 'koulchiPrice'
            ]) &&
            request.resource.data.status == resource.data.status
          )
        )
      );

      allow delete: if isAdmin() || (
        isApprovedVendor(request.auth.uid) &&
        resource.data.vendorId == request.auth.uid
      );
    }

    /* ============================================================
       COMMANDES
       Création et annulation client via Cloud Functions seulement.
       Le client ne peut donc jamais modifier stockDeducted.
       ============================================================ */

    /* ============================================================
       DEMANDES DE RAMASSAGE VENDEUR
       Le vendeur cree une demande (statut pending) ; seul l admin
       peut l approuver. La creation produit exige une demande
       approuvee (voir pickupApproved dans /products).
       ============================================================ */
    match /vendor_pickup_requests/{requestId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.vendorId == request.auth.uid);

      allow create: if isApprovedVendor(request.auth.uid) &&
        request.resource.data.vendorId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 50 &&
        request.resource.data.desiredDate is string &&
        request.resource.data.desiredDate.size() == 10 &&
        (!('comment' in request.resource.data) ||
          (request.resource.data.comment is string &&
           request.resource.data.comment.size() <= 500)) &&
        request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Les commandes globales contiennent les coordonnées de livraison.
      // Les vendeurs lisent exclusivement leur projection expurgée dans
      // vendor_orders/{vendorId}/orders.
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if false;

      allow update: if isAdmin() || (
        isApprovedVendor(request.auth.uid) &&
        resource.data.get('containsPlatformItems', true) == false &&
        resource.data.get('vendorIds', []) is list &&
        resource.data.vendorIds.size() == 1 &&
        request.auth.uid in resource.data.vendorIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt'
        ]) &&
        (
          (resource.data.status == 'pending' && request.resource.data.status == 'confirmed') ||
          (resource.data.status == 'confirmed' && request.resource.data.status == 'shipping')
        )
      );

      allow delete: if isAdmin();
    }

    /* ============================================================
       COMMANDES PRIVÉES PAR VENDEUR
       ============================================================ */

    match /vendor_orders/{vendorId}/orders/{orderId} {
      // L'identifiant vendeur est porté par le chemin ; aucune écriture client
      // n'est permise dans cette collection.
      // privacySafe n'est écrit que par les Cloud Functions serveur après
      // suppression des coordonnées et identifiants acheteur.
      allow read: if isAdmin() ||
        (isApprovedVendor(vendorId) && resource.data.get('privacySafe', false) == true);
      allow create, update, delete: if false;
    }

    /* ============================================================
       DEMANDES DE RETRAIT
       Création via Cloud Function ; lecture limitée au vendeur approuvé.
       ============================================================ */

    match /payout_requests/{requestId} {
      allow read: if isAdmin() ||
        (
          isSignedIn() &&
          resource.data.vendorId == request.auth.uid &&
          isApprovedVendor(request.auth.uid)
        );
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    /* ============================================================
       PORTEFEUILLES
       ============================================================ */

    match /wallets/{vendorId} {
      allow read: if isAdmin() || isApprovedVendor(vendorId);
      allow create, update, delete: if false;
    }

    match /wallet_transactions/{transactionId} {
      allow read: if isAdmin() ||
        (
          isSignedIn() &&
          resource.data.vendorId == request.auth.uid &&
          isApprovedVendor(request.auth.uid)
        );
      allow create, update, delete: if false;
    }

    /* ============================================================
       AVIS
       ============================================================ */

    match /reviews/{reviewId} {
      allow read: if resource.data.get('status', '') == 'approved' ||
        isAdmin() ||
        (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);

      // La création est exclusivement serveur : verifiedPurchase ne peut
      // plus être fourni ou falsifié depuis le navigateur.
      allow create: if false;

      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.get('status', '') == 'approved' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likesCount']) &&
        request.resource.data.likes is list &&
        (
          (
            request.resource.data.likes.size() == resource.data.get('likes', []).size() + 1 &&
            request.resource.data.likes.hasAll(resource.data.get('likes', [])) &&
            request.auth.uid in request.resource.data.likes &&
            !(request.auth.uid in resource.data.get('likes', [])) &&
            request.resource.data.likesCount == resource.data.get('likesCount', 0) + 1
          ) ||
          (
            request.resource.data.likes.size() == resource.data.get('likes', []).size() - 1 &&
            resource.data.get('likes', []).hasAll(request.resource.data.likes) &&
            request.auth.uid in resource.data.get('likes', []) &&
            !(request.auth.uid in request.resource.data.likes) &&
            request.resource.data.likesCount == resource.data.get('likesCount', 0) - 1
          )
        )
      );

      allow delete: if isAdmin();
    }

    /* ============================================================
       JUSTIFICATIFS DES FRAIS DE RETOUR
       Lecture admin ou vendeur propriétaire uniquement.
       Toute écriture passe par Cloud Functions Admin SDK.
       ============================================================ */

    match /order_return_fees/{feeId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        resource.data.get('vendorId', '') == request.auth.uid &&
        isVendorOwner(request.auth.uid)
      );
      allow create, update, delete: if false;
    }

    /* ============================================================
       COLLECTIONS DIVERSES
       ============================================================ */

    match /blog/{docId} {
      /* Correctif audit 2026-11-20 : les brouillons n'ont pas à être
         lisibles publiquement. js/blog.js ne requête que
         status == 'published' : aucune régression fonctionnelle. */
      allow read: if isAdmin() ||
        (resource.data.get('status', '') == 'published');
      allow write: if isAdmin();
    }

    match /coupons/{docId} {
      /* Un visiteur doit pouvoir verifier UN code precis (getDoc) pour
         l appliquer a son panier : `get` reste public. En revanche
         `list` (enumeration de la collection) est reserve a l admin,
         sinon n importe qui peut aspirer tous les codes promo.
         Audit fonctionnel 2026-11-19.
         RISQUE RESIDUEL ASSUME (audit 2026-11-20) : ce `get` permet de
         tester des codes devines. Il est MITIGE par :
           1. la revalidation complete cote serveur dans
              createCustomerOrder (isActive, expiresAt, maxUses,
              minPurchase, usedCount) : un code devine ne donne aucun
              avantage non valide ;
           2. `list` reste interdit, donc pas d'extraction de masse.
         ACTION RECOMMANDEE cote admin : generer des codes de 8+
         caracteres avec suffixe aleatoire (ex. BIENVENUE-7K3QX9)
         pour rendre le tirage par force brute non rentable. */
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    /* ============================================================
       VENTES FLASH (audit 2026-11-16)
       ------------------------------------------------------------
       Une vente flash applique une remise TEMPORAIRE et BORNEE sur un
       ensemble de produits. Le prix final est recalcule cote serveur dans
       createCustomerOrder : le client ne peut jamais imposer un prix
       remise via cette collection.

       - Lecture publique limitee aux ventes ACTIVES (le client n'a pas
         besoin de voir les brouillons ni les ventes archivees).
       - Un vendeur approuve ne cree/modifie que des ventes `scope:
         'vendor'` sur SON uid, et ne peut pas toucher `soldCount`.
       - L'admin plateforme a l'acces complet.
       ============================================================ */

    match /flash_sales/{saleId} {
      allow read: if resource.data.get('status', '') == 'active' || isAdmin() ||
        (isSignedIn() && resource.data.get('vendorId', '') == request.auth.uid);

      allow create: if isAdmin() || (
        /* CORRECTIF (2026-11-16) : decision produit -> pas de validation
           admin. Le vendeur publie DIRECTEMENT en 'active' (ou 'draft' s il
           veut preparer). L ancienne regle imposait status == 'draft', ce
           qui contredisait l UI vendeur. */
        isApprovedVendor(request.auth.uid) &&
        request.resource.data.scope == 'vendor' &&
        request.resource.data.vendorId == request.auth.uid &&
        request.resource.data.soldCount == 0 &&
        request.resource.data.status in ['draft', 'active'] &&
        request.resource.data.productIds is list &&
        request.resource.data.productIds.size() > 0 &&
        request.resource.data.discountValue is number &&
        request.resource.data.discountValue > 0 &&
        request.resource.data.discountType in ['percent', 'fixed']
      );

      allow update: if isAdmin() || (
        isApprovedVendor(request.auth.uid) &&
        resource.data.get('scope', '') == 'vendor' &&
        resource.data.get('vendorId', '') == request.auth.uid &&
        request.resource.data.vendorId == resource.data.vendorId &&
        request.resource.data.scope == resource.data.scope &&
        /* Un vendeur ne modifie pas le compteur de ventes. */
        request.resource.data.get('soldCount', 0) == resource.data.get('soldCount', 0) &&
        request.resource.data.discountValue is number &&
        request.resource.data.discountValue > 0
      );

      allow delete: if isAdmin() || (
        isApprovedVendor(request.auth.uid) &&
        resource.data.get('scope', '') == 'vendor' &&
        resource.data.get('vendorId', '') == request.auth.uid
      );
    }

    match /cities/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /purchases/{docId} {
      allow read, write: if isAdmin();
    }

    match /expenses/{docId} {
      allow read, write: if isAdmin();
    }

    match /transactions/{docId} {
      allow read, write: if isAdmin();
    }

    match /coupon_uses/{docId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /notifications/{docId} {
      allow read: if isAdmin() ||
        (
          isSignedIn() &&
          (
            resource.data.get('userId', '') == request.auth.uid ||
            resource.data.get('vendorId', '') == request.auth.uid
          )
        );
      allow create: if isAdmin();

      // Un utilisateur peut uniquement marquer ses propres notifications comme lues.
      allow update: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('vendorId', '') == request.auth.uid
        ) &&
        resource.data.get('read', false) == false &&
        request.resource.data.get('read', false) == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      );

      // La suppression reste limitée au propriétaire ou à un administrateur.
      allow delete: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('vendorId', '') == request.auth.uid
        )
      );
    }

    /* ============================================================
       COLLECTIONS SENSIBLES — REFUS EXPLICITE (audit 2026-11-16)
       ------------------------------------------------------------
       Ces collections n'avaient AUCUNE clause dediee : elles tombaient
       dans le refus par defaut. Le comportement ne change donc pas, mais
       on le rend EXPLICITE et documente. Sans cela, une future regle
       mal ciblee pouvait les exposer sans qu'aucun relecteur ne le voie.

       - vendorCredentials  : hash bcrypt des mots de passe vendeurs.
                              Ecriture/lecture uniquement via Admin SDK
                              (setVendorPassword / loginVendor).
       - vendorLoginThrottle: compteurs d'echecs de connexion.
                              Ecrit uniquement par loginVendor.
       - order_requests     : demandes de commande en attente de validation.
       - livo_webhook_events: journal d'idempotence des webhooks Livo.
       - meta               : caches techniques (livo_fees_cache, etc.).
       ============================================================ */

    match /vendorCredentials/{uid} {
      allow read, write: if false;
    }

    match /vendorLoginThrottle/{throttleId} {
      allow read, write: if false;
    }

    match /order_requests/{requestId} {
      allow read, write: if false;
    }

    match /livo_webhook_events/{eventId} {
      allow read, write: if false;
    }

    match /meta/{docId} {
      allow read, write: if false;
    }

    /* ============================================================
       CONFIGURATION APPLICATIVE
       Source unique de verite (ex. contractVersion). Ecriture serveur
       uniquement ; la lecture par les regles passe par get() et ne
       requiert aucune autorisation client.
       ============================================================ */

    /* ============================================================
       THÈME COMMERCIAL (calendrier saisonnier)
       ------------------------------------------------------------
       Le moteur de calendrier lit `config/theme.forcedEvent` pour
       permettre un forçage manuel depuis l'administration.
       Seul ce document est lisible publiquement ; `config/app`
       (contractVersion) reste réservé aux administrateurs.
       Aucune écriture client : la valeur se pose via la console
       Firebase ou une fonction serveur.
       ============================================================ */
    match /config/theme {
      allow read: if true;
      allow write: if false;
    }

    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* ============================================================
       MESURE D AUDIENCE (dashboard admin)
       ------------------------------------------------------------
       analytics_daily : compteurs agreges par jour (anonymes).
       presence        : battement de coeur par visiteur (TTL 5 min).
       Le champ expireAt (now + 7 jours) pilote la purge automatique
       par la politique TTL Firestore, voir docs/runbooks.

       Aucune donnee personnelle : identifiant pseudonyme, chemin de
       page, horodatage. Pas d IP, pas de nom, pas d email.
       Ecriture ouverte aux visiteurs anonymes (l audience n est pas
       authentifiee), lecture reservee aux administrateurs.
       ============================================================ */

    /* Ecriture analytics_daily : deux flux distincts.
       - vue anonyme (tous les visiteurs) : { views, updatedAt }
       - vue consentie (visiteurs uniques) : { visitors, updatedAt }
       Chaque champ est donc optionnel, mais valide s il est present. */
    function analyticsWriteValid() {
      /* Firestore Rules ne connait pas `const` : on utilise `let`. */
      let d = request.resource.data;
      return d.keys().hasOnly(['views', 'visitors', 'updatedAt']) &&
        (!d.keys().hasAny(['views']) || (d.views is int && d.views >= 0 && d.views <= 1000000)) &&
        /* Correctif audit 2026-11-20 : plafond abaissé de 20 000 à 5 000
           entrées. Au-delà, le document approche la limite de 1 Mio et
           un visiteur malveillant peut gonfler le coût d'écriture. */
        (!d.keys().hasAny(['visitors']) || (d.visitors is list && d.visitors.size() <= 5000)) &&
        d.updatedAt == request.time;
    }

    function presenceWriteValid() {
      let d = request.resource.data;
      /* expireAt est optionnel pour rester compatible avec un onglet
         ouvert pendant le deploiement, mais toujours valide s il est
         present : timestamp futur, borne a 8 jours. */
      let expireOk = !d.keys().hasAny(['expireAt']) ||
        (d.expireAt is timestamp &&
         d.expireAt > request.time &&
         d.expireAt < request.time + duration.value(8, 'd'));
      return d.keys().hasOnly(['lastSeen', 'sessionId', 'path', 'expireAt']) &&
        expireOk &&
        d.lastSeen == request.time &&
        d.sessionId is string &&
        d.sessionId.size() >= 8 &&
        d.sessionId.size() <= 64 &&
        d.path is string &&
        d.path.size() >= 1 &&
        d.path.size() <= 120;
    }

    match /analytics_daily/{dateId} {
      allow read: if isAdmin();
      allow create, update: if analyticsWriteValid() &&
        dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      /* Suppression : bouton "Remettre a zero" de l admin. */
      allow delete: if isAdmin();
    }

    match /presence/{visitorId} {
      allow read: if isAdmin();
      allow create, update: if presenceWriteValid() &&
        visitorId.matches('^[a-zA-Z0-9-]{8,64}$');
      /* Meme bouton : la presence repart de zero. */
      allow delete: if isAdmin();
    }

    /* REFUS PAR DÉFAUT */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

