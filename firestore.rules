rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ============================================================
       FONCTIONS UTILITAIRES
       ============================================================ */
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isApprovedVendor() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'vendor' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vendorInfo.status == 'approved' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vendorInfo.contractStatus == 'accepted';
    }

    /* USERS */
    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid);

      allow create: if isAdmin() || (isSelf(uid) &&
        request.resource.data.get('isAdmin', false) == false &&
        request.resource.data.get('permissions', []) == [] && (
          request.resource.data.role == 'user' ||
          (request.resource.data.role == 'vendor' &&
           request.resource.data.signupMethod == 'vendor' &&
           request.resource.data.vendorInfo.status == 'pending' &&
           request.resource.data.vendorInfo.contractStatus == 'pending')
        ));

      allow update: if isAdmin() || (isSelf(uid) && (
        (
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
          request.resource.data.get('permissions', []) == resource.data.get('permissions', []) &&
          request.resource.data.get('vendorId', uid) == resource.data.get('vendorId', uid) &&
          request.resource.data.get('vendorInfo', {}).get('status', null) == resource.data.get('vendorInfo', {}).get('status', null) &&
          request.resource.data.get('vendorInfo', {}).get('contractStatus', null) == resource.data.get('vendorInfo', {}).get('contractStatus', null) &&
          request.resource.data.get('vendorInfo', {}).get('commissionRate', null) == resource.data.get('vendorInfo', {}).get('commissionRate', null) &&
          request.resource.data.get('vendorInfo', {}).get('currentContractId', null) == resource.data.get('vendorInfo', {}).get('currentContractId', null) &&
          request.resource.data.get('vendorInfo', {}).get('contractVersion', null) == resource.data.get('vendorInfo', {}).get('contractVersion', null) &&
          request.resource.data.get('vendorInfo', {}).get('contractSignedAt', null) == resource.data.get('vendorInfo', {}).get('contractSignedAt', null)
        ) || (
          resource.data.get('role', 'user') == 'user' &&
          request.resource.data.role == 'vendor' &&
          request.resource.data.signupMethod == 'vendor' &&
          request.resource.data.vendorInfo.status == 'pending' &&
          request.resource.data.vendorInfo.contractStatus == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'email', 'phone', 'role', 'signupMethod',
            'emailVerified', 'vendorInfo', 'updatedAt', 'createdAt'
          ])
        )
      ));

      allow delete: if isAdmin();
    }

    /* VENDEURS PUBLICS */
    match /vendorsPublic/{vendorId} {
      allow read: if true;
      allow write: if false;
    }

    /* CONTRATS : écriture réservée aux Cloud Functions */
    match /contracts/{contractId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.vendorId == request.auth.uid);
      allow create, update, delete: if false;
    }

    /* PRODUITS */
    match /products/{productId} {
      allow read: if true;

      allow create: if isAdmin() || (
        isApprovedVendor() &&
        request.resource.data.vendorId == request.auth.uid &&
        request.resource.data.status == 'pending_admin_approval' &&
        !('salesCount' in request.resource.data) &&
        !('ratingAvg' in request.resource.data)
      );

      allow update: if isAdmin() || (
        isApprovedVendor() &&
        resource.data.vendorId == request.auth.uid &&
        request.resource.data.vendorId == resource.data.vendorId &&
        !('salesCount' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('ratingAvg' in request.resource.data.diff(resource.data).affectedKeys()) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasAny(['price', 'nameFr', 'nameEn', 'nameAr']) &&
           request.resource.data.status == 'pending_admin_approval') ||
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['price', 'nameFr', 'nameEn', 'nameAr']) &&
           request.resource.data.status == resource.data.status)
        )
      );

      allow delete: if isAdmin() || (
        isApprovedVendor() &&
        resource.data.vendorId == request.auth.uid
      );
    }

    /* COMMANDES */
    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        (isSignedIn() && resource.data.vendorIds is list && request.auth.uid in resource.data.vendorIds);

      allow create: if false;

      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid &&
         resource.data.status in ['pending', 'confirmed'] &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'updatedAt', 'stockDeducted'])) ||
        (isApprovedVendor() &&
         resource.data.vendorIds is list && request.auth.uid in resource.data.vendorIds &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) && (
           (resource.data.status == 'pending' && request.resource.data.status == 'confirmed') ||
           (resource.data.status == 'confirmed' && request.resource.data.status == 'shipping') ||
           (resource.data.status == 'shipping' && request.resource.data.status == 'delivered')
         ));

      allow delete: if isAdmin();
    }

    /* RETRAITS */
    match /payout_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.vendorId == request.auth.uid);
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    /* PORTEFEUILLES */
    match /wallets/{vendorId} {
      allow read: if isAdmin() || (isSignedIn() && vendorId == request.auth.uid);
      allow write: if false;
    }

    match /wallet_transactions/{transactionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.vendorId == request.auth.uid);
      allow write: if false;
    }

    /* AVIS */
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' ||
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'userId', 'userName', 'productId', 'productName',
          'rating', 'comment', 'status', 'createdAt', 'orderId', 'photos', 'verifiedPurchase'
        ]) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() <= 3000 &&
        request.resource.data.status == 'pending';

      allow update, delete: if isAdmin();
    }

    /* COLLECTIONS DIVERSES */
    match /blog/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /coupons/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /cities/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /purchases/{docId} { allow read, write: if isAdmin(); }
    match /expenses/{docId} { allow read, write: if isAdmin(); }
    match /transactions/{docId} { allow read, write: if isAdmin(); }
    match /coupon_uses/{docId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /notifications/{docId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    /* REFUS PAR DÉFAUT */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}