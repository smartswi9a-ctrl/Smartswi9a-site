# ============================================================
# functions/.env — variables des Cloud Functions (NON versionné)
# ------------------------------------------------------------
# Copier ce fichier en `functions/.env` puis renseigner les valeurs.
# Firebase charge automatiquement functions/.env au déploiement.
# ============================================================

# EmailJS — OBLIGATOIRE (compte en « strict mode ») :
# Account → Security → Private Key. Sans elle, l'API répond
# 403 « API access in strict mode, but no Private Key was provided »
# et les emails sont ignorés SANS consommer le quota.
EMAILJS_PRIVATE_KEY=

# Jeton HMAC des liens de désinscription (optionnel : la clé
# publique EmailJS sert de repli si vide).
EMAILJS_UNSUB_SECRET=
