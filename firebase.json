{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "firestore.rules",
      "storage.rules",
      "firestore.indexes.json",
      "migrate-cities.html",
      "generer-villes.html",
      "js/emailjs.js",
      "logo-generator.html",
      "README.md",
      "**/functions/**"
    ],
    "cleanUrls": true,
    "trailingSlashBehavior": "remove",
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp|svg|gif|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(self), payment=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://apis.google.com https://smartswi9a-31063.firebaseapp.com https://accounts.google.com https://connect.facebook.net https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://firebasestorage.googleapis.com https://*.googleusercontent.com https://*.googleapis.com https://*.fbcdn.net https://graph.facebook.com; media-src 'self' https://videos.smartswi9a.top; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.cloudfunctions.net wss://*.firebaseio.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://graph.facebook.com https://accounts.google.com https://api.emailjs.com https://cdn.jsdelivr.net https://*.livo.ma https://*.workers.dev; frame-src 'self' https://smartswi9a-31063.firebaseapp.com https://accounts.google.com https://www.facebook.com https://web.facebook.com https://www.gstatic.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/setVendorPassword",
        "function": {
          "functionId": "setVendorPassword",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/loginVendor",
        "function": {
          "functionId": "loginVendor",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/signVendorContract",
        "function": {
          "functionId": "signVendorContract",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/acceptVendorContract",
        "function": {
          "functionId": "acceptVendorContract",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/adminVendorAction",
        "function": {
          "functionId": "adminVendorAction",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/requestWithdrawal",
        "function": {
          "functionId": "requestWithdrawal",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/releaseDueFunds",
        "function": {
          "functionId": "releaseDueFunds",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/createCustomerOrder",
        "function": {
          "functionId": "createCustomerOrder",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/cancelCustomerOrder",
        "function": {
          "functionId": "cancelCustomerOrder",
          "region": "europe-west1"
        }
      },
      {
        "source": "/vendor/dashboard",
        "destination": "/vendor/dashboard.html"
      },
      {
        "source": "/villes",
        "destination": "/villesmaroc.html"
      },
      {
        "source": "/villes.html",
        "destination": "/villesmaroc.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  }
}