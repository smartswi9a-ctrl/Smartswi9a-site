  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "smartswi9a-31063",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      "cloudflare/**",
      "tests/**",
      "scripts/**",
      "docs/**",
      "functions/**",
      "node_modules/**",
      "**/node_modules/**",
      "_headers",
      "_redirects",
      "package.json",
      "package-lock.json",
      "README.md",
      "**/*.md",
